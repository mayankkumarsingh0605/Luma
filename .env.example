# Groq API Key (Required for AI responses)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Backend server port
PORT=3001

# Groq model (Default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# Google Calendar OAuth 2.0 Client Credentials (Phase 1)
# Create in Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/api/calendar/oauth/callback
